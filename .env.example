# 复制本文件为 .env 并填写真实值
# API Key 兼容链：系统变量 DEEPSEEK_API_KEY → DATAOPAI_API_KEY → API_KEY，或在此填写
# 当前示例为通义千问 DashScope；如用 DeepSeek 改为 https://api.deepseek.com 与 deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=qwen-plus
PDF_DIR=knowledge_base
CHROMA_DIR=data/chroma
TOP_K=5
MIN_SCORE=0.35
CHUNK_SIZE=500
CHUNK_OVERLAP=50
HF_ENDPOINT=https://hf-mirror.com
HOST=127.0.0.1
PORT=8000
